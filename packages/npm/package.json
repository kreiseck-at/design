{
  "name": "@kreiseck/design",
  "version": "0.4.1",
  "description": "Design tokens, colour roles for four modes, brand ramp and the icon set shared by all Kreiseck surfaces.",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/kreiseck-at/design", "directory": "packages/npm" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./icons": { "types": "./dist/icons.d.ts", "import": "./dist/icons.js" },
    "./tokens.css": "./src/tokens.css",
    "./svg/*": "./svg/*",
    "./fonts.css": "./fonts.css",
    "./fonts/*": "./fonts/*"
  },
  "files": ["dist", "svg", "src/tokens.css", "fonts", "fonts.css", "README.md", "LICENSE"],
  "sideEffects": ["*.css"],
  "scripts": {
    "build": "tsup",
    "prepack": "tsup"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8"
  }
}
